{
    "version": "2.2.0",
    "description": "PiliPlus - A feature-rich Bilibili client",
    "homepage": "https://github.com/bggRGjQaUbCoE/PiliPlus",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/bggRGjQaUbCoE/PiliPlus/releases/download/2.2.0/PiliPlus_windows_2.2.0+5580_x64_portable.zip",
            "hash": "61e2a1c7bc8b2d1287151c462e41e0cec089972d387bc4babbabbd5ca3440e0b"
        }
    },
    "extract_dir": "PiliPlus-Win",
    "shortcuts": [
        [
            "piliplus.exe",
            "PiliPlus"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    $parent = \"$env:APPDATA\\com.example\"",
        "    Remove-Item \"$parent\\piliplus\" -Recurse -Force -ErrorAction SilentlyContinue",
        "    if ((Test-Path $parent) -and (Get-ChildItem $parent -Force | Measure-Object).Count -eq 0) {",
        "        Remove-Item $parent -Force -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": {
        "script": [
            "$response = Invoke-RestMethod 'https://api.github.com/repos/bggRGjQaUbCoE/PiliPlus/releases/latest'",
            "$tag = $response.tag_name",
            "$asset = $response.assets | Where-Object { $_.name -match 'PiliPlus_windows_.*_x64_portable\\.zip' } | Select-Object -First 1",
            "if ($asset.name -match 'PiliPlus_windows_([\\d.]+)\\+(\\d+)_x64_portable\\.zip') {",
            "    \"$tag $($Matches[1]) $($Matches[2])\"",
            "}"
        ],
        "regex": "(?<version>[\\d.]+) (?<winver>[\\d.]+) (?<build>\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bggRGjQaUbCoE/PiliPlus/releases/download/$version/PiliPlus_windows_$matchWinver+$matchBuild_x64_portable.zip"
            }
        }
    }
}
